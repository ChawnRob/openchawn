# ── OpenChawn Configuration ──────────────────────────────
# Copier en .env et adapter les valeurs

# Mode : development | production
OPENCHAWN_ENV=development

# Secret pour les JWT (CHANGER EN PROD)
OPENCHAWN_SECRET_KEY=change-me-with-a-random-64-char-string-here

# CORS — origines autorisées (séparées par virgule)
OPENCHAWN_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Provider ─────────────────────────────────────────────
# "auto" = sélection par priorité : minimax → mistral → ollama → openai
# Ou forcer un provider : minimax | mistral | ollama | openai
OPENCHAWN_PROVIDER=auto

# Profil par défaut
OPENCHAWN_PROFILE=default

# ── MiniMax (priorité 1) ─────────────────────────────────
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_BASE_URL=https://api.minimax.io/v1

# ── Mistral API cloud (priorité 2) ───────────────────────
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# ── Ollama local (priorité 3) ────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ── OpenAI (priorité 4, dernier recours) ─────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Rate limiting ────────────────────────────────────────
OPENCHAWN_RATE_CHAT=30
OPENCHAWN_RATE_AUTH=10
OPENCHAWN_MAX_MSG_LEN=4000
OPENCHAWN_JWT_HOURS=24

# ── Database ─────────────────────────────────────────────
OPENCHAWN_DB_PATH=./data/openchawn.db
