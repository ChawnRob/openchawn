# ── OpenChawn Configuration ──────────────────────────────
# Copier en .env et adapter les valeurs

# Mode : development | production
OPENCHAWN_ENV=development

# Secret pour les JWT (CHANGER EN PROD)
OPENCHAWN_SECRET_KEY=change-me-with-a-random-64-char-string-here

# CORS — origines autorisées (séparées par virgule)
OPENCHAWN_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Provider ─────────────────────────────────────────────
# "auto" = sélection par priorité : minimax → mistral → ollama → openai
# Ou forcer un provider : minimax | mistral | ollama | openai
OPENCHAWN_PROVIDER=auto

# ── Texte chat (COCO) — Groq prioritaire, premium opt-in ─
DEFAULT_TEXT_PROVIDER=groq
TEXT_PROVIDER_ORDER=local,groq,kimi,deepseek,mistral,openai,infomaniak,openrouter
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENAI_ENABLED=false
ANTHROPIC_ENABLED=false
ALLOW_PREMIUM_MODELS=false

# Profil par défaut
OPENCHAWN_PROFILE=default

# ── MiniMax (priorité 1) ─────────────────────────────────
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_BASE_URL=https://api.minimax.io/v1

# ── Mistral API cloud (priorité 2) ───────────────────────
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# ── Ollama local (priorité 3) ────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ── OpenAI (priorité 4, dernier recours) ─────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Web search (COCO P0 — disabled by default) ───────────
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=perplexity
WEB_SEARCH_MAX_RESULTS=5

# Conversation continuity (P1.4) — short-term entity state TTL in seconds (default 1200)
CONVERSATION_CONTINUITY_TTL_SECONDS=1200
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=llama-3.1-sonar-small-128k-online
PERPLEXITY_BASE_URL=https://api.perplexity.ai
# Optional alternative provider:
# WEB_SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=

# ── Image intake — analyse vs génération (séparés) ───────
# Analyse : local/slm → kimi → openai (fallback)
IMAGE_ANALYSIS_PROVIDER_ORDER=local,kimi,openai
IMAGE_ANALYSIS_DEFAULT_PROVIDER=kimi
IMAGE_ANALYSIS_FALLBACK_PROVIDER=openai
IMAGE_GENERATION_PROVIDER=openai
# Modèles vision dédiés (optionnel)
# IMAGE_ANALYSIS_KIMI_MODEL=moonshot-v1-8k-vision-preview
# IMAGE_ANALYSIS_OPENAI_MODEL=gpt-4o-mini

# ── Moonshot Kimi (endpoint /chat — principal) ───────────
MOONSHOT_API_KEY=
# Optionnel : base OpenAI-compatible (défaut api.moonshot.cn)
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# ── OpenRouter (cloud par défaut pour /chat) ──────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/auto
# Moteur LLM pour la gateway /chat : openrouter | ollama | (vide = OpenRouter si clé)
MODEL_PROVIDER=openrouter

# ── Rate limiting ────────────────────────────────────────
OPENCHAWN_RATE_CHAT=30
OPENCHAWN_RATE_AUTH=10
OPENCHAWN_MAX_MSG_LEN=4000
OPENCHAWN_JWT_HOURS=24
# Quota invité / jour (priorité à GUEST_DAILY_MESSAGE_LIMIT, sinon OPENCHAWN_GUEST_DAILY_LIMIT, défaut 20)
GUEST_DAILY_MESSAGE_LIMIT=20
# OPENCHAWN_GUEST_DAILY_LIMIT=20

# Accès privé owner (Bearer) — bypass quota invité ; ne jamais committer de valeur réelle
OPENCHAWN_OWNER_TOKEN=

# ── AFFiNE Second Brain (primary visual workspace) ─────────
AFFINE_ENABLED=true
AFFINE_BASE_URL=https://app.affine.pro
AFFINE_DEEP_SYNC_ENABLED=false
# OPENCHAWN_AFFINE_LOCAL_URL=
# OPENCHAWN_AFFINE_URL=

# ── Obsidian optional Markdown sync (not a Second Brain replacement) ──
OBSIDIAN_ENABLED=true
OBSIDIAN_MODE=uri
OBSIDIAN_VAULT_NAME=OpenChawn
OBSIDIAN_DEFAULT_FOLDER=COCO
OBSIDIAN_SYNC_ENABLED=false
OBSIDIAN_LOCAL_REST_API_URL=https://127.0.0.1:27124
OBSIDIAN_LOCAL_REST_API_TOKEN=

# ── Database ─────────────────────────────────────────────
OPENCHAWN_DB_PATH=./data/openchawn.db
