# ─── Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
build/
dist/

# ─── Virtualenvs
venv/
.venv/
env/
ENV/

# ─── Secrets & env
.env
.env.local
*.pem
*.key

# ─── Runtime data (local dev / ephemeral containers)
# Auth SQLite, fractal JSON, semantic indexes, QEI logs, MemPalace, etc.
data/
data/**/*.db
data/memory/
data/memory/*.json
data/qei/
data/mempalace/

# Local SQLite databases (runtime auth / dev copies)
*.db
*.sqlite
*.sqlite3

# Fuse / filesystem artifacts (e.g. macOS FUSE hidden copies)
**/.fuse_hidden*
.fuse_hidden*

# Legacy memory runtime stores (keep memory/*.py source modules)
memory/*.json
memory/*.jsonl
memory/fractal

# ─── IDE / OS
.idea/
.vscode/
.DS_Store
*.swp
*.swo

# ─── Tests
.pytest_cache/
.coverage
htmlcov/
.tox/

# ─── Logs
*.log
logs/
