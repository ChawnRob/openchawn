{
  "policy_name": "OPENCHAWN_CONTROLLED_EVOLUTION_DOCTRINE",
  "policy_version": "V11.7",
  "allowed_actions": [
    "observe_runtime_behavior",
    "analyze_logs",
    "analyze_conversations",
    "analyze_memory_events",
    "analyze_provider_failures",
    "analyze_ux_feedback",
    "detect_recurring_problems",
    "generate_improvement_proposals",
    "create_structured_tickets",
    "suggest_prompt_improvements",
    "suggest_memory_improvements",
    "suggest_routing_improvements",
    "suggest_ux_improvements",
    "suggest_architecture_improvements",
    "generate_patch_drafts",
    "run_sandbox_tests",
    "compare_versions_with_measurable_evaluation"
  ],
  "forbidden_actions": [
    "modify_production_code_directly",
    "push_to_main_without_human_validation",
    "deploy_to_production_autonomously",
    "overwrite_stable_git_tags",
    "delete_critical_memory_without_backup_and_audit",
    "change_owner_public_access_rules_without_approval",
    "change_provider_routing_in_production_without_tests",
    "alter_system_prompts_silently",
    "alter_safety_rules_silently",
    "perform_unexplainable_actions",
    "perform_irreversible_actions_without_rollback",
    "perform_untestable_actions",
    "perform_unrepairable_actions"
  ],
  "required_gates": [
    "observation",
    "evaluation",
    "improvement_proposal",
    "sandbox_execution",
    "human_approval",
    "git_versioning",
    "deployment_review",
    "post_deploy_monitoring"
  ],
  "required_proposal_fields": [
    "proposal_id",
    "problem",
    "evidence",
    "affected_module",
    "proposed_change",
    "expected_benefit",
    "risk_level",
    "rollback_plan",
    "test_plan",
    "target_version"
  ],
  "rollback_required": true,
  "human_approval_required": true,
  "production_self_modification_allowed": false,
  "stable_tag_overwrite_allowed": false
}
